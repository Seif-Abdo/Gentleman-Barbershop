# Gentleman Barbershop - Environment Configuration

# Google Form Response URL (pre-configured to Gentleman form)
GOOGLE_FORM_RESPONSE_URL=https://docs.google.com/forms/d/e/1FAIpQLSfUOJC0hmhl8POLFmm20VCk1qLJxaVJvOBx3NBPuNF1Ds7_zQ/formResponse

# Google Sheets Integration (for Admin Dashboard)
# 1. In Google Forms > Responses tab > click "Link to Sheets"
# 2. Extract the Sheet ID from the URL: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=

# Google Cloud Service Account (Needs Viewer access to the linked Sheet)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Admin Dashboard Password (default: gentleman2026)
ADMIN_PASSWORD=gentleman2026
